# Solana Configuration
SOLANA_PRIVATE_KEY=your_base58_private_key_here
SOLANA_RPC_URL=https://api.devnet.solana.com

# OpenRouter Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-4o

# Jupiter API (optional)
JUPITER_API_KEY=your_jupiter_api_key_here

# ═══════════════════════════════════════════════════════
# RISK MANAGEMENT (Adjust based on your risk tolerance)
# ═══════════════════════════════════════════════════════

# Max USD amount per trade (start small!)
MAX_TRADE_SIZE_USD=100

# Stop trading if daily loss exceeds this amount
MAX_DAILY_LOSS_USD=50

# Max % of portfolio in single token (0.3 = 30%)
MAX_POSITION_CONCENTRATION=0.3

# Stop loss percentage
STOP_LOSS_PERCENT=5

# Take profit percentage
TAKE_PROFIT_PERCENT=10

# Minimum token liquidity required (in USD)
MIN_LIQUIDITY_USD=100000

# ═══════════════════════════════════════════════════════
# AGENT SETTINGS
# ═══════════════════════════════════════════════════════

# Max cycles (0 = infinite)
MAX_CYCLES=0

# Time between cycles in milliseconds (300000 = 5 minutes)
CYCLE_INTERVAL_MS=300000

# Dry run mode - set to true to test without executing trades
DRY_RUN=false
