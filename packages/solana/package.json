{
  "name": "@agentic-wallet/solana",
  "version": "0.0.1",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js",
      "require": "./dist/plugin.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup index.ts plugin.ts --format esm --dts --clean --sourcemap"
  },
  "dependencies": {
    "@agentic-wallet/core": "workspace:*",
    "@pump-fun/pump-sdk": "^1.31.0",
    "@bonfida/name-offers": "^0.3.0-alpha.4",
    "@bonfida/spl-name-service": "^3.0.19",
    "@metaplex-foundation/mpl-token-metadata": "^3.4.0",
    "@raydium-io/raydium-sdk-v2": "^0.2.32-alpha",
    "@solana-name-service/sns-sdk-kit": "^0.9.4-beta",
    "@solana-program/token": "^0.12.0",
    "@solana/kit": "^6.2.0",
    "@solana/kora": "^0.1.3",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4",
    "@types/bn.js": "^5.2.0",
    "bn.js": "^5.2.3",
    "bs58": "^6.0.0",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "description": "Solana wallet implementation with Jupiter, Raydium, and Pump.fun plugins",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Jonathanthedeveloper/agentic-wallet.git",
    "directory": "packages/solana"
  },
  "keywords": ["solana", "wallet", "ai", "agent", "jupiter", "raydium", "pumpfun", "defi"],
  "devDependencies": {
    "@types/bs58": "^5.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}