{
  "compilerOptions": {
    "lib": [
      "ESNext"
    ],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false,
    "baseUrl": ".",
    "paths": {
      "@agentic-wallet/core": [
        "packages/core/index.ts"
      ],
      "@agentic-wallet/solana": [
        "packages/solana/index.ts"
      ],
      "@agentic-wallet/solana/plugin": [
        "packages/solana/src/plugin.ts"
      ],
      "@agentic-wallet/adapters-vercel": [
        "packages/adapters-vercel/index.ts"
      ],
      "@agentic-wallet/adapters-tanstack": [
        "packages/adapters-tanstack/index.ts"
      ]
    }
  }
}